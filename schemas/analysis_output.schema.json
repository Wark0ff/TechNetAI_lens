{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:technet:schema:analysis-output:1.0.0",
  "title": "TechNet Analysis Output",
  "type": "object",
  "required": [
    "metadata",
    "executive_summary",
    "claims",
    "mechanism_map",
    "maturity_assessment",
    "unknowns",
    "overall_confidence"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["analysis_id", "unit", "date"],
      "properties": {
        "analysis_id": { "type": "string" },
        "unit": { "type": "string" },
        "industry": { "type": ["string", "null"] },
        "period": { "type": ["string", "null"] },
        "date": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "executive_summary": { "type": "string" },
    "claims": {
      "type": "array",
      "items": { "$ref": "urn:technet:schema:claim:1.0.0" }
    },
    "mechanism_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["challenge", "technology", "solution", "effect", "status"],
        "properties": {
          "challenge": { "type": "string" },
          "technology": { "type": "string" },
          "solution": { "type": "string" },
          "effect": { "type": "string" },
          "system_consequence": { "type": ["string", "null"] },
          "status": { "enum": ["established", "probable", "hypothesis", "not_established"] },
          "source_refs": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "maturity_assessment": {
      "type": "object",
      "required": ["dominant_level", "range", "dimensions", "contradictory_features"],
      "properties": {
        "dominant_level": {
          "enum": ["F0", "F1", "F2", "F3", "F4", "F5", "undetermined"]
        },
        "range": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["F0", "F1", "F2", "F3", "F4", "F5", "undetermined"] }
        },
        "dimensions": { "type": "array", "items": { "type": "object" } },
        "contradictory_features": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "trl_assessment": {
      "type": "object",
      "properties": {
        "key_technology": { "type": ["string", "null"] },
        "trl": { "type": ["integer", "null"], "minimum": 1, "maximum": 9 },
        "justification": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "alternatives": { "type": "array", "items": { "type": "string" } },
    "lever_options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lever": {
            "enum": [
              "digital_design_and_virtual_testing",
              "smart_and_additive_manufacturing",
              "cross_industry_transfer_and_sovereign_platforms"
            ]
          },
          "option": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "tradeoffs": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "overall_confidence": { "enum": ["low", "medium", "high"] }
  },
  "additionalProperties": false
}
